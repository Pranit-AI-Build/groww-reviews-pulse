# Groww Reviews Collector - Environment Configuration

# App Configuration
APP_NAME=Groww
PLAYSTORE_APP_ID=com.nextbillion.groww
PLAYSTORE_URL=https://play.google.com/store/apps/details?id=com.nextbillion.groww&hl=en_IN

# Review Collection Settings
WEEKS_TO_COLLECT=10
MIN_RATING=1
MAX_RATING=5
LANGUAGE=en
COUNTRY=IN

# Storage
DATA_DIR=data
DATABASE_PATH=data/reviews.db

# Logging
LOG_LEVEL=INFO
